@startuml 01-diagrama-general

title Modelo de Dominio General — Bloque 1 (M01 + M02)\n<size:11>Vista integrada de nivel superior — versión oficial congelada</size>

' =============================================================================
' CONFIGURACIÓN VISUAL Y PALETA CROMÁTICA
' =============================================================================

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 60

skinparam noteFontSize 10
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #E6C200

hide circle
hide empty members

skinparam class {
  BackgroundColor<<entity>> #EBF3FA
  BorderColor<<entity>> #2B6CB0
  HeaderBackgroundColor<<entity>> #3182CE

  BackgroundColor<<value object>> #F3E8FA
  BorderColor<<value object>> #805AD5
  HeaderBackgroundColor<<value object>> #805AD5

  BackgroundColor<<enum>> #FFF5F5
  BorderColor<<enum>> #E53E3E
  HeaderBackgroundColor<<enum>> #E53E3E
}

skinparam package {
  BorderColor #CBD5E0
  BackgroundColor #FAFAFA
  FontColor #1A202C
  FontStyle bold
}

' =============================================================================
' MÓDULO M01 — ORGANIZACIÓN DEL NEGOCIO
' =============================================================================

package "M01 — Organización del Negocio" as M01 {

  class Usuario <<entity>> {
    identidad
    nombre
    email : Email
    estadoCuenta
    fechaRegistro
  }

  class UsuarioNegocio <<entity>> {
    rol : Rol
    estado : EstadoMembresia
    fechaIncorporacion
  }

  class Negocio <<entity>> {
    identidad
    nombre
    rubro [0..1]
    monedaBase : Moneda
    modalidades : Set<ModalidadOperativa> {1..*}
  }

  class InvitacionNegocio <<entity>> {
    identificadorSeguro
    emailDestino : Email
    rolPropuesto : Rol
    estado : EstadoInvitacion
    fechaExpiracion
  }

  class Email <<value object>>

  enum Rol <<enum>> {
    PROPIETARIO
    ENCARGADO
    TRABAJADOR
  }

  enum EstadoMembresia <<enum>> {
    ACTIVO
    INACTIVO
  }

  enum EstadoInvitacion <<enum>> {
    PENDIENTE
    ACEPTADA
    RECHAZADA
    CANCELADA
    EXPIRADA
  }

  enum ModalidadOperativa <<enum>> {
    REVENTA
    PRODUCCION
    SERVICIOS
  }

  enum Moneda <<enum>> {
    ARS
  }
}

' =============================================================================
' MÓDULO M02 — CATÁLOGO
' =============================================================================

package "M02 — Catálogo" as M02 {

  class Categoria <<entity>> {
    identidad
    nombre
    estado : EstadoCategoria
  }

  class ArticuloCatalogo <<entity>> {
    identidad
    nombre
    tipo : TipoArticulo
    unidadMedida : UnidadMedida
    sku [0..1]
    precioBase [0..1]
    estado : EstadoArticulo
  }

  class CapacidadesArticulo <<value object>> {
    esComprable : Boolean
    esVendible : Boolean
    controlaStock : Boolean
    puedeUsarseEnProduccion : Boolean
    controlaVencimiento : Boolean
    permiteDescuento : Boolean
  }

  enum EstadoCategoria <<enum>> {
    ACTIVA
    INACTIVA
  }

  enum EstadoArticulo <<enum>> {
    ACTIVO
    INACTIVO
  }

  enum TipoArticulo <<enum>> {
    BIEN
    SERVICIO
  }

  enum UnidadMedida <<enum>> {
    UNIDAD
    KG
    G
    L
    ML
    M
    CM
    HORA
  }
}

' =============================================================================
' RELACIONES PRINCIPALES
' =============================================================================

' Estructura M01
Usuario "1" -- "0..*" UsuarioNegocio : membresías
UsuarioNegocio "1..*" -- "1" Negocio : pertenece a
Negocio "1" -- "0..*" InvitacionNegocio : invitaciones
UsuarioNegocio "1" -- "0..*" InvitacionNegocio : emite

' Conexión M01 -> M02
Negocio "1" -right- "0..*" Categoria : organiza
Negocio "1" -right- "0..*" ArticuloCatalogo : contiene

' Estructura M02
Categoria "0..1" -- "0..*" ArticuloCatalogo : clasifica
ArticuloCatalogo "1" *-- "1" CapacidadesArticulo : define

' =============================================================================
' NOTAS CONCEPTUALES DE ALTO NIVEL
' =============================================================================

note top of M01
  <b>Organización e Identidad (M01)</b>
  • Usuario representa la identidad global (0..N membresías).
  • Rol y Estado pertenecen a UsuarioNegocio.
  • Existe una única membresía histórica por combinación Usuario + Negocio.
  • Negocio debe conservar al menos 1 PROPIETARIO activo.
  • La aceptación de invitaciones se coordina atómicamente en el Caso de Uso.
end note

note top of M02
  <b>Catálogo Unificado (M02)</b>
  • ArticuloCatalogo unifica BIEN y SERVICIO.
  • CapacidadesArticulo define elegibilidad/configuración, no hechos operativos.
  • Categoria y ArticuloCatalogo pertenecen contextualmente a un Negocio.
end note

@enduml
